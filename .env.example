# LLM_MODEL=openai/gpt-oss-120b
# LLM_FALLBACK_MODEL=openai/gpt-oss-20b    # tip: use 20b while testing to save 120b tokens for the demo
# STT_MODEL=whisper-large-v3
# TTS_VOICE=hannah
